"""Round-based simulation orchestrator."""
from __future__ import annotations

import re

from collections import deque
from dataclasses import dataclass
from typing import Any, Callable, Deque, Dict, Iterable, List, Optional, Sequence, Set, Tuple

from ..agents.detector import DetectorAgent
from ..agents.generator import GeneratorAgent
from ..agents.user import UserAgent
from ..community.experience import Experience
from ..community.graph import CommunityGraph
from ..core.news import NewsItem
from ..optimization.detector_optimizer import DetectorStrategyOptimizer
from ..optimization.generator_optimizer import GeneratorStrategyOptimizer
from ..optimization.generator_strategy_agent import GeneratorStrategyAgent
from ..scoring.metrics import RoundScore, ScoreCalculator
from ..utils.ids import IdGenerator
from ..utils.logging import get_logger
from ..utils.parsing import coerce_int

logger = get_logger(__name__)

OpinionCallback = Callable[[UserAgent, NewsItem], str]


@dataclass(slots=True)
class RoundResult:
    news_item: NewsItem
    opinions: List[str]
    propagation_history: List[List[str]]
    infected_users: List[str]
    detector_payload: Dict[str, object]
    score: RoundScore
    ground_truth_raw: int
    ground_truth_final: int
    rewrite_applied: bool
    generator_prompt_digest: str
    generator_prompt_sample: str
    generator_prompt_rationale: str


class SimulationOrchestrator:
    def __init__(
        self,
        generator: GeneratorAgent,
        detector: DetectorAgent,
        community: Dict[str, UserAgent],
        graph: CommunityGraph,
        *,
        score_calculator: Optional[ScoreCalculator] = None,
        opinion_callback: Optional[OpinionCallback] = None,
        propagation_rounds: int = 1,
        generator_optimizer: Optional[GeneratorStrategyOptimizer] = None,
        detector_optimizer: Optional[DetectorStrategyOptimizer] = None,
    ) -> None:
        self._generator = generator
        self._detector = detector
        self._community = community
        self._graph = graph
        self._score_calculator = score_calculator or ScoreCalculator()
        self._opinion_callback = opinion_callback
        self._id_gen = IdGenerator(prefix="news")
        self._base_propagation_rounds = max(1, propagation_rounds)
        self._generator_optimizer = generator_optimizer
        self._detector_optimizer = detector_optimizer
        self._round_index = 0  # round counter
        self._strategy_agent = GeneratorStrategyAgent()
        self._prompt_history: Deque[Dict[str, Any]] = deque(maxlen=self._strategy_agent.history_limit)
        self._current_generator_prompt = generator.system_prompt
        self._last_successful_prompt = self._current_generator_prompt
        self._fallback_prompt = generator.system_prompt

    def simulate_round(
        self,
        original_news: str,
        *,
        ground_truth_raw: int,
        ground_truth_final: int,
        seed_users: Sequence[str],
        rewrite: bool = True,
        propagation_rounds: Optional[int] = None,
    ) -> RoundResult:
        self._round_index += 1
        round_index = self._round_index
        news_id = self._id_gen.next()
        self._latest_optimizer_rationale = ""

        if self._generator.system_prompt != self._current_generator_prompt:
            self._generator.update_prompt(self._current_generator_prompt)

        generator_strategy: Optional[str] = None
        modified_news = original_news
        operation_log = None
        raw_generation = None
        generation_payload: Dict[str, Any] = {}

        if rewrite:
            generation_payload = self._generator.generate(original_news)
            modified_news = generation_payload.get("modified_news", original_news)
            operation_log = generation_payload.get("operation_log")
            raw_generation = generation_payload.get("raw_output")
            generator_strategy = generation_payload.get("strategy_used") or "unspecified"
        else:
            generator_strategy = "none"

        news_item = NewsItem(
            news_id=news_id,
            original_text=original_news,
            generated_text=str(modified_news),
            operation_log=operation_log,
            generator_strategy=generator_strategy,
            raw_generation=raw_generation,
            generator_sources=(generation_payload.get("evidence") if rewrite else None),
        )
        news_item.factuality_label = ground_truth_final
        news_item.original_truth_label = ground_truth_raw
        news_item.rewrite_applied = rewrite
        logger.info("Generated news %s", news_id)

        rounds = propagation_rounds or self._base_propagation_rounds
        propagation_history, infected_users = self._propagate(news_item, seed_users, rounds)
        news_item.propagation_history = propagation_history
        news_item.infected_users = sorted(infected_users)

        opinions = self._gather_opinions(news_item)
        news_item.opinions = opinions

        detector_strategy = self._detector_optimizer.suggest() if self._detector_optimizer else None
        detector_result = self._detector.detect(
            news_item.generated_text or news_item.original_text,
            opinions,
            strategy_hint=detector_strategy,
        )
        authenticity = coerce_int(detector_result.get("authenticity", 0))
        news_item.detector_strategy = detector_strategy
        news_item.raw_detection = detector_result.get("raw_output") if isinstance(detector_result, dict) else None
        news_item.detector_operation_log = (detector_result.get("operation_log") if isinstance(detector_result, dict) else None)

        score = self._score_calculator.score(
            detector_label=authenticity,
            ground_truth=ground_truth_final,
            infected_users=len(infected_users),
            total_users=len(self._community),
        )

        self._update_experience(
            news_item=news_item,
            detector_label=authenticity,
            opinions=opinions,
            ground_truth_final=ground_truth_final,
            ground_truth_raw=ground_truth_raw,
            round_index=round_index,
        )
        optimizer_strategy = generator_strategy if rewrite else None
        self._update_optimizers(optimizer_strategy, detector_strategy, score)

        detector_payload = detector_result if isinstance(detector_result, dict) else {"raw": detector_result}
        generator_success = score.generator.detection_evasion >= 100.0
        prompt_digest = self._prompt_digest(self._current_generator_prompt)
        prompt_sample = self._current_generator_prompt[:120]
        proposal_rationale = getattr(self, "_latest_optimizer_rationale", "")
        self._record_generator_history(
            round_index=round_index,
            prompt=self._current_generator_prompt,
            strategy=generator_strategy or "none",
            score=score,
            detector_payload=detector_payload,
            generation_payload=generation_payload,
            rewrite=rewrite,
            success=generator_success,
            news_item=news_item,
        )
        self._update_generator_prompt_after_round(rewrite=rewrite, success=generator_success)

        return RoundResult(
            news_item=news_item,
            opinions=opinions,
            propagation_history=propagation_history,
            infected_users=sorted(infected_users),
            detector_payload=detector_payload,
            score=score,
            ground_truth_raw=ground_truth_raw,
            ground_truth_final=ground_truth_final,
            rewrite_applied=rewrite,
            generator_prompt_digest=prompt_digest,
            generator_prompt_sample=prompt_sample,
            generator_prompt_rationale=proposal_rationale,
        )

    def _propagate(
        self,
        news_item: NewsItem,
        seed_users: Sequence[str],
        rounds: int,
    ) -> Tuple[List[List[str]], Set[str]]:
        history: List[List[str]] = []
        frontier: Set[str] = set(seed_users)
        visited: Set[str] = set()
        infected: Set[str] = set(frontier)
        for seed_id in list(frontier):
            seed_user = self._community.get(seed_id)
            if seed_user:
                seed_user.seed_news(
                    news_item.news_id,
                    news_item.generated_text or news_item.original_text,
                )
        depth = 0
        while frontier and depth < rounds:
            history.append(sorted(frontier))
            belief_delta = max(0.2, 0.6 - depth * 0.1)
            next_frontier: Set[str] = set()
            for user_id in frontier:
                user = self._community[user_id]
                user.receive_news(news_item.news_id, news_item.generated_text or news_item.original_text, belief_delta)
                neighbours = self._graph.neighbours(user_id)
                targets = user.propagate_targets(neighbours)
                for target_id in targets:
                    if target_id in infected or target_id == user_id:
                        continue
                    target = self._community[target_id]
                    target.receive_news(
                        news_item.news_id,
                        news_item.generated_text or news_item.original_text,
                        max(0.1, belief_delta - 0.1),
                    )
                    next_frontier.add(target_id)
                    infected.add(target_id)
            visited.update(frontier)
            frontier = next_frontier - visited
            depth += 1
        return history, infected

    def _prompt_digest(self, prompt: str) -> str:
        if not prompt:
            return "empty"
        normalized = " ".join(prompt.split())
        return f"{hash(prompt) & 0xFFFF:04x}:{normalized[:80]}"

    def _record_generator_history(
        self,
        *,
        round_index: int,
        prompt: str,
        strategy: str,
        score: RoundScore,
        detector_payload: Dict[str, Any],
        generation_payload: Dict[str, Any],
        rewrite: bool,
        success: bool,
        news_item: NewsItem,
    ) -> None:
        entry: Dict[str, Any] = {
            "round": round_index,
            "prompt_digest": self._prompt_digest(prompt),
            "prompt_sample": prompt[:120],
            "strategy_used": strategy,
            "rewrite": rewrite,
            "detected": not success,
            "generator_score": score.generator.total,
            "detection_evasion": score.generator.detection_evasion,
            "detector_score": score.detector.total,
            "generator_operation": news_item.operation_log,
            "generator_evidence": generation_payload.get("evidence"),
            "detector_feedback": news_item.detector_operation_log,
        }
        self._prompt_history.append(entry)
        if success and rewrite:
            self._last_successful_prompt = prompt

    def _update_generator_prompt_after_round(self, rewrite: bool, success: bool) -> None:
        if not rewrite:
            return
        history_for_agent = list(self._prompt_history)
        default_prompt = self._last_successful_prompt or self._fallback_prompt
        proposal = self._strategy_agent.propose(history_for_agent, default_prompt=default_prompt)
        proposed_prompt = proposal.get("next_prompt") or default_prompt
        rationale = proposal.get("rationale", "")
        self._latest_optimizer_rationale = rationale
        confidence = proposal.get("confidence", 0.0)
        try:
            confidence_value = float(confidence)
        except (TypeError, ValueError):
            confidence_value = 0.0
        adopt = bool(proposed_prompt.strip())
        if confidence_value < 0.2 and not success:
            adopt = False
        if adopt:
            adjustments = proposed_prompt.strip()
            if adjustments:
                new_prompt = (
                    f"{self._fallback_prompt}\n\n"
                    f"# Optimizer adjustments (round {self._round_index}):\n{adjustments}"
                )
            else:
                new_prompt = self._fallback_prompt
        else:
            new_prompt = default_prompt
        if not new_prompt.strip():
            new_prompt = self._fallback_prompt
        if self._generator.system_prompt != new_prompt:
            self._current_generator_prompt = new_prompt
            self._generator.update_prompt(new_prompt)
        else:
            self._current_generator_prompt = new_prompt

    def _gather_opinions(self, news_item: NewsItem) -> List[str]:
        if self._opinion_callback is None:
            return []
        opinions: List[str] = []
        for user in self._community.values():
            if news_item.news_id in user.state.inbox:
                try:
                    opinion = self._opinion_callback(user, news_item)
                except Exception as exc:  # pragma: no cover - logging guard
                    logger.warning("Opinion callback failed: %s", exc)
                    continue
                opinions.append(opinion)
        return opinions

    def _update_experience(
        self,
        *,
        news_item: NewsItem,
        detector_label: int,
        opinions: Sequence[str],
        ground_truth_final: int,
        ground_truth_raw: int,
        round_index: int,
    ) -> None:
        """Write per-user, per-round record (current stance+reason+detector+truth), then apply feedback."""
        text = (news_item.generated_text or news_item.original_text or "") or ""

        def _reasons_for(user: UserAgent) -> tuple[list[str], list[str], Optional[int]]:
            low = text.lower()
            persona = user.state.persona
            pos: list[str] = []
            neg: list[str] = []
            if getattr(persona, "location", None) and persona.location.lower() in low:
                pos.append(f"it references my city ({persona.location})")
            else:
                neg.append("no direct relevance to my location")
            if getattr(persona, "occupation", None) and persona.occupation.lower() in low:
                pos.append(f"it concerns my profession ({persona.occupation})")
            else:
                neg.append("not related to my professional domain")
            interests = getattr(persona, "interests", ()) or ()
            hits = [kw for kw in interests if isinstance(kw, str) and kw and kw.lower() in low]
            if hits:
                pos.append(f"it matches my interests ({', '.join(hits[:3])})")
            else:
                neg.append("does not match my personal interests")
            tokens = ("according to", "report", "study", "expert", "research", "who", "cdc")
            has_auth = any(tok in low for tok in tokens) or ('"' in text)
            if has_auth:
                pos.append("it cites authorities or includes quotes")
            else:
                neg.append("no verifiable source or quote is cited")
            if re.search(r"\d{2,}", text):
                pos.append("it provides concrete figures/dates")
            else:
                neg.append("lacks concrete numbers or dates")
            depth = None
            if news_item.propagation_history:
                for i, layer in enumerate(news_item.propagation_history):
                    if persona.user_id in layer:
                        depth = i
                        break
            if depth is not None:
                if depth <= 1:
                    pos.append("I saw it early in the cascade (direct/nearby source)")
                else:
                    neg.append("I only saw it after multiple hops (possible distortion)")
            else:
                neg.append("unclear how the news reached me")
            return pos, neg, depth

        for user in self._community.values():
            if news_item.news_id not in user.state.inbox:
                continue
            belief = user.state.belief.belief_strength
            threshold = user.state.belief.propagation_threshold
            pos, neg, depth = _reasons_for(user)
            believes = belief >= threshold
            stance = "believes" if believes else "is skeptical of"
            reasons = (pos if believes else neg) or (neg if believes else pos) or ["insufficient evidence"]
            user_reason = "; ".join(reasons[:2])

            experience = Experience(
                news_id=news_item.news_id,
                verdict=detector_label,
                rationale=user_reason,
                strategies=(news_item.operation_log,) if news_item.operation_log else (),
                user_id=user.state.persona.user_id,
                news_text=text,
                user_stance=stance,
                user_reason=user_reason,
                detector_verdict=detector_label,
                detector_reason=news_item.detector_operation_log,
                ground_truth=ground_truth_final,
                ground_truth_raw=ground_truth_raw,
                round_index=round_index,
                propagation_depth=depth,
                generator_operation_log=news_item.operation_log,
            )
            user.reinforce(experience)
            user.apply_detection_feedback(news_item.news_id, detector_label)
    def _update_optimizers(
        self,
        generator_strategy: Optional[str],
        detector_strategy: Optional[str],
        score: RoundScore,
    ) -> None:
        if self._generator_optimizer and generator_strategy:
            succeeded = score.generator.detection_evasion >= 100.0
            self._generator_optimizer.update(generator_strategy, success=succeeded)
        if self._detector_optimizer and detector_strategy:
            self._detector_optimizer.update(detector_strategy, accuracy=score.detector.total)



















